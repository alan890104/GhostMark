{
  "sourceLanguage" : "en",
  "strings" : {
    "Accessibility access is required to intercept image pastes" : {
      "comment" : "Status message shown when the app needs Accessibility permission.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "要攔截圖片貼上，請先開啟「輔助使用」權限" } }
      }
    },
    "Allow access" : {
      "comment" : "Primary onboarding button before Accessibility permission is granted.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟權限" } }
      }
    },
    "Cancel" : {
      "comment" : "Button that closes the editor without changing the clipboard.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消" } }
      }
    },
    "Cancelled — the original clipboard is unchanged" : {
      "comment" : "Status message shown after cancelling an edit.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已取消，剪貼簿內容沒有變更" } }
      }
    },
    "Choose color" : {
      "comment" : "Accessibility label for a color swatch.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇顏色" } }
      }
    },
    "Copy image" : {
      "comment" : "Button that finishes a manual clipboard edit and copies the image.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製圖片" } }
      }
    },
    "Couldn't paste automatically — image copied to the clipboard" : {
      "comment" : "Status message shown when GhostMark could not restore the target app's focus or post the image paste.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法自動貼上，圖片已複製到剪貼簿" } }
      }
    },
    "Mark it. Send it to your AI agent." : {
      "comment" : "Onboarding headline that describes marking an image and sending it to an AI agent.",
      "localizations" : {
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "標記圖片，再送給你的 AI Agent。" } }
      }
    },
    "Couldn't export the marked-up image" : {
      "comment" : "Status message shown when rendering the edited image fails.",
